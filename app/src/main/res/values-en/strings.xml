    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_consent_prefix">I agree to the </string>
    <string name="privacy_policy_link">privacy policy</string>
    <string name="error_privacy_policy_not_accepted">You must accept the privacy policy</string>
    <string name="privacy_policy_got_it">Got it</string>
    <string name="privacy_policy_trust_no_sale">We do not sell or share data with third parties</string>
    <string name="privacy_policy_trust_purpose">Data is used only to operate the service</string>
    <string name="privacy_policy_trust_secure">Information is transmitted over secure channels</string>
    <string name="privacy_policy_intro">We care about your privacy. In PropertyManagement, your personal data is used only to operate the service and is protected with modern security measures.</string>
    <string name="privacy_policy_section_data_title">What data we collect</string>
    <string name="privacy_policy_section_data_body">Name, email address, phone number, profile details, listing information, property photos, and purchase or rental application data. This information is required to create an account and use the app fully.</string>
    <string name="privacy_policy_section_purpose_title">How we use your data</string>
    <string name="privacy_policy_section_purpose_body">Your data is used only for specific purposes: account registration and sign-in, publishing and moderating listings, processing applications by agency managers, sending notifications about listing and application status, and improving service quality. We do not use your data for unrelated purposes and do not sell it to third parties.</string>
    <string name="privacy_policy_section_storage_title">Storage and protection</string>
    <string name="privacy_policy_section_storage_body">Data is stored on secure servers with restricted access. Information is transmitted over encrypted channels. Only authorized staff and systems required to operate the service can access personal data.</string>
    <string name="privacy_policy_section_rights_title">Your rights</string>
    <string name="privacy_policy_section_rights_body">You can view and update your profile data in the app, change your email and password, and contact agency support to clarify or delete data in accordance with applicable law.</string>
    <string name="privacy_policy_section_contact_title">Contact</string>
    <string name="privacy_policy_section_contact_body">If you have questions about this privacy policy or data processing, contact us through the profile section or reach out to the real estate agency providing the PropertyManagement service.</string>
